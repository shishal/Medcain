# Copy to .env (gitignored). Never commit real keys.
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Dashboard → Project Settings → Database → Connect → Connection pooling (URI)
# Used only by scripts/ — never in the Flutter app.
# Pooler user MUST be postgres.<project_ref> (bare "postgres" → "no tenant identifier").
# Prefer pooler if db.<ref>.supabase.co fails DNS (common without IPv6 / VPN).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Dashboard → Project Settings → API → service_role (seed/sync scripts only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Phase 7.1/7.2 — external web checkout. The Flutter app only opens this URL
# in the device browser; never collect payment inside the app.
# Local page: python3 checkout/serve.py
# Android emulator must use 10.0.2.2 (that is the host machine).
# Production: https://medico.shishal.com/checkout
CHECKOUT_URL=http://127.0.0.1:4173

# Phase 7.2 — Razorpay Test Mode keys (Dashboard → Test Mode → API Keys).
# Used only by the create-razorpay-order Edge Function — never the Flutter app.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Phase 7.3 — Razorpay Dashboard → Webhooks → Secret (Test Mode).
# razorpay-webhook verifies X-Razorpay-Signature with this. Never in Flutter.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Public site (docker compose at repo root). Optional; defaults shown.
MEDICO_SITE_PORT=8083
# Only needed for `docker compose --profile tunnel up`
CLOUDFLARE_TUNNEL_TOKEN=
