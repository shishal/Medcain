# The site container reads the repo-root .env (next to docker-compose.yml),
# not a copy in this folder. These two public values are written to
# /checkout/config.js at startup. Razorpay secrets stay out of the container.
MEDICO_SITE_PORT=8083
CLOUDFLARE_TUNNEL_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
