# Copy to `.env` in the directory you run `docker compose` from
# (repo root, or this folder).
MEDICO_SITE_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=

# Public Supabase values (same as the Flutter app). The container writes
# these into /checkout/config.js at startup. Do not put Razorpay secrets here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
