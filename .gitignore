# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Editor settings stay on this machine.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Android client config. Codemagic writes it from GOOGLE_SERVICES_JSON.
# The FCM service-account key is a Supabase secret and must never be committed.
/android/app/google-services.json

# Widget Preview related
.widget_preview/

# Secrets and local env
.env
.env.*
!.env.example
# Flutter asset copy of the public keys only. Android drops a ".env" asset.
assets/env

# Checkout page config (anon key is public, but keep local copies out of git)
checkout/config.js
website/public/checkout/config.js
website/public/admin/config.js

# Script tooling (local venvs for one-off DB validators)
scripts/.venv/

# Local DB dumps (contain user data — never commit)
backups/

# Supabase local dev artifacts
supabase/.branches
supabase/.temp
